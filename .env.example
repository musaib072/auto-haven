# Copy this file to `.env` (local) and add the same keys in Vercel →
# Project → Settings → Environment Variables (Production + Preview).
# All VITE_* values are embedded in the browser bundle — never put secret keys here.

# ── Supabase (car listings, enquiry records, photo uploads) ────────────────
VITE_SUPABASE_URL=https://xoxyymuuvfvllsuxfqer.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# ── EmailJS (form submissions → email) ─────────────────────────────────────
# Dashboard: https://dashboard.emailjs.com  (see EMAIL_SETUP.md)
# REQUIRED — without the public key NO emails are sent.
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=service_autoflexxii
VITE_EMAILJS_BOOKING_TEMPLATE_ID=template_booking
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_contact

# Optional: where enquiries are sent (defaults to Autoflexiiii@gmail.com).
# Only used if your EmailJS templates have "To Email" set to {{to_email}}.
# VITE_ENQUIRY_RECIPIENT=Autoflexiiii@gmail.com

# ── Site ───────────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap and social previews.
VITE_SITE_URL=https://autoflexii.com
